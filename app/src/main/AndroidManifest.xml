<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.houselocation">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="House Location"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HouseLocation">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SignUpActivity" android:exported="true" />
        <activity android:name=".HomeActivity" android:exported="true" />
        <activity android:name=".HouseDetailsActivity" android:exported="true" />
        <activity android:name=".MapActivity" android:exported="true" />
        <activity android:name=".EditHouseActivity" android:exported="true" />
        <activity android:name=".AddHouseActivity" android:exported="true" />

    </application>
</manifest>
